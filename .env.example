# Optional: enables automated structured retrieval when the CDE website returns
# its JavaScript protection page. Never commit the real key; put it in .env.local.
CHINA_DRUG_TRIALS_API_KEY=

# Optional. openFDA works without a key; a free key only raises the official
# daily request allowance. Never commit the real key.
OPENFDA_API_KEY=

# Optional: enables evidence-grounded AI answers through DeepSeek's
# OpenAI-compatible Chat Completions API. Keep the real key in .env.local or
# the deployment secret store; never expose it in browser JavaScript.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Legacy OpenAI configuration remains supported when no DeepSeek key is set.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_API_BASE=https://api.openai.com/v1

# Set to 1 in privacy-sensitive development or testing environments to ensure
# that no question or evidence is sent to an external model.
ASSISTANT_DISABLE_MODEL=0
