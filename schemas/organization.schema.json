{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://qisichen.cn/schemas/organization.schema.json",
  "title":"Organization","type":"object","additionalProperties":true,
  "required":["id","name","kind","status","source_ids"],
  "properties":{"id":{"type":"string","pattern":"^org-[a-z0-9-]+$"},"name":{"type":"string","minLength":1},"kind":{"type":"string","minLength":1},"status":{"enum":["active","acquired","merged"]},"parent_org_id":{"type":"string"},"successor_org_id":{"type":"string"},"source_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}}
}
