server {
  listen 80;
  listen [::]:80;
  server_name __SERVER_NAME__;

  root /var/www/neuroimmune-cart-hub/current;
  index index.html;

  charset utf-8;

  access_log /var/log/nginx/neuroimmune-cart-hub.access.log;
  error_log /var/log/nginx/neuroimmune-cart-hub.error.log warn;

  gzip on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_types
    text/plain
    text/css
    application/javascript
    application/json
    application/xml
    image/svg+xml;

  location / {
    try_files $uri $uri/ $uri.html /404.html;
  }

  location ~* \.(?:js|css|svg|ico|png|jpg|jpeg|webp|woff|woff2)$ {
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
  }

  location ~* \.json$ {
    expires 5m;
    add_header Cache-Control "public, max-age=300";
    try_files $uri =404;
  }

  location = /404.html {
    internal;
  }
}
